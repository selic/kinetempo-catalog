    {
      "id": "kinetempo-chin-tuck",
      "name": "Chin tuck",
      "description": "Sitting or lying, slide the chin straight back — a gentle double chin — while the back of the neck lengthens. The head stays level; this is not a nod. You should feel a mild pull at the base of the skull and the deep front muscles of the neck working, not the throat straining. Hold ten seconds, release for five, ten times.",
      "videoUrl": null,
      "steps": [
        {
          "tone": "squeeze",
          "durationMs": 10000,
          "label": "Chin back, neck long"
